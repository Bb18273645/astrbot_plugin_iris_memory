#!/bin/sh
# Fork 自有功能守卫：推送前检查关键实现是否还在。
# 需求：任何一次上游同步都不允许把自己的功能弄丢。

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

if [ -x ".venv/Scripts/python.exe" ]; then
    python_bin=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    python_bin=".venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    python_bin="python"
elif command -v python3 >/dev/null 2>&1; then
    python_bin="python3"
else
    echo "fork-guard: 找不到 Python，跳过守卫检查" >&2
    exit 0
fi

"$python_bin" -m pytest tests/fork -q || {
    echo "fork-guard: 自有功能缺失，已阻止推送。运行 python -m pytest tests/fork -q 查看原因。" >&2
    exit 1
}
